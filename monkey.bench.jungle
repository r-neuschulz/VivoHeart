project.manifest = bin/manifest.bench.xml
base.sourcePath = source
base.resourcePath = resources;resources-bench
# Benchmark build: production data path + VivoHeartBenchView, own app id/name.
# Manifest is generated by scripts/New-TestManifest.ps1 (Run-Benchmark.ps1 / Sideload-Test.ps1 call it).
base.excludeAnnotations = debugHrData;nobench;diag
